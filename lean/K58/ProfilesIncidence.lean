/-- The finite check behind `arith_filter`: in the bounded box, every count
vector satisfying the conditions is in `cand`. -/
theorem arith_key :
    ∀ x : Fin 15 × Fin 8 × Fin 5 × Fin 3 × Fin 2,
      ((x.1.val + 2 * x.2.1.val + 3 * x.2.2.1.val + 4 * x.2.2.2.1.val
          + 5 * x.2.2.2.2.val = 14) ∧
       (6 ≤ x.1.val + x.2.1.val + x.2.2.1.val + x.2.2.2.1.val + x.2.2.2.2.val) ∧
       (x.2.2.2.2.val ≤ 1) ∧ (x.2.2.2.1.val ≤ 2) ∧
       (x.2.2.2.2.val = 1 → x.2.2.2.1.val = 0)) →
      (x.1.val, x.2.1.val, x.2.2.1.val, x.2.2.2.1.val, x.2.2.2.2.val) ∈ cand := by
  decide

/-- **The arithmetic filter.**  `c1..c5` count the classes of multiplicity
1..5 in one ordinary arm.  X1-X5 and `sum m = 14` force one of the 48 listed
vectors. -/
theorem arith_filter {c1 c2 c3 c4 c5 : ℕ}
    (hsum : c1 + 2 * c2 + 3 * c3 + 4 * c4 + 5 * c5 = 14)
    (hX4 : 6 ≤ c1 + c2 + c3 + c4 + c5) (hX2 : c5 ≤ 1) (hX5 : c4 ≤ 2)
    (hX3 : c5 = 1 → c4 = 0) :
    (c1, c2, c3, c4, c5) ∈ cand := by
  have h1 : c1 < 15 := by omega
  have h2 : c2 < 8 := by omega
  have h3 : c3 < 5 := by omega
  have h4 : c4 < 3 := by omega
  have h5 : c5 < 2 := by omega
  exact arith_key (⟨c1, h1⟩, ⟨c2, h2⟩, ⟨c3, h3⟩, ⟨c4, h4⟩, ⟨c5, h5⟩)
    ⟨hsum, hX4, hX2, hX5, hX3⟩

/-- **X5 is redundant** given X4: a profile of 14 with at least six classes
cannot have three classes of multiplicity four. -/
theorem x5_redundant {c1 c2 c3 c4 c5 : ℕ}
    (hsum : c1 + 2 * c2 + 3 * c3 + 4 * c4 + 5 * c5 = 14)
    (hX4 : 6 ≤ c1 + c2 + c3 + c4 + c5) : c4 ≤ 2 := by
  omega


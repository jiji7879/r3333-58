import K58.Cases

namespace K58.Frozen

/-- One family in the frozen ledger. Each interval stores a start and a length
in the mixed-radix ordering of its three placement indices. -/
structure Family where
  arm : Fin 4
  mark : ℕ
  sixteen : Bool
  twisted : Bool
  root : ℕ
  middleRadix : ℕ
  lastRadix : ℕ
  runs : List (ℕ × ℕ)

set_option maxRecDepth 100000
set_option maxHeartbeats 0


 def read_tree(rid):
+    """Read the raw state for mutation or diagnostics; terminal fields are unverified."""
     loc=RUNS/rid/'tree.json'
     return json.loads(loc.read_bytes()) if loc.exists() else {'id':rid,'splits':{},'closed':{}}
+
+
+def checked_tree(rid):
+    """Replay persisted terminal claims before resume, scheduling, or export.
+
+    Invalid evidence remains an explicit nonterminal cache failure. The raw tree
+    is passed to verify_native so a concurrent replacement cannot validate one
+    tree while this function returns another. No solver is launched here.
+    """
+    tree=None
+    try:
+        tree=read_tree(rid)
+        if not isinstance(tree,dict):raise ValueError('cached tree is not a JSON object')
+        root=tree.get('root_verdict')
+        closed=tree.get('closed',{})
+        if root is None and not closed:return tree
+        if root not in (None,'UNSAT_BASE','SAT_BASE'):
+            raise ValueError(f'invalid cached root verdict {root!r}')
+        if not isinstance(closed,dict) or set(closed.values())-DEAD:
+            raise ValueError('invalid/nonterminal status in cached closed map')
+        from verify_campaign import verify_native
+        verify_native(rid,tree=tree)
+        return tree
+    except Exception as exc:
+        clean=dict(tree) if isinstance(tree,dict) else {'id':rid,'splits':{}}
+        clean.pop('root_verdict',None);clean['closed']={}
+        clean['cache_status']='INVALID_CACHE'
+        clean['cache_error']=f'{type(exc).__name__}: {exc}'[-1000:]
+        return clean
 
 
